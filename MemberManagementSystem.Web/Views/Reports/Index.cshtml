@{
    ViewData["Title"] = "Reports Center";
}

<div class="mb-4">
    <h3 class="fw-bold mb-1">রিপোর্ট সেন্টার (Reports & Analytics)</h3>
    <p class="text-muted small">Generate, print and export operational and financial reports</p>
</div>

<div class="row g-4">
    <!-- Report 1: Member List -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-3">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">সদস্য তালিকা রিপোর্ট</h5>
                        <small class="text-muted">Member Directory Report</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Complete list of members with contact info, status, district, and joining dates. Filterable and printable.
                </p>
                <a asp-action="MemberList" class="btn btn-outline-primary w-100 mt-2">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Report 2: New Members -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-success-subtle text-success p-3 rounded-3">
                        <i class="fa-solid fa-user-plus fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">নতুন সদস্য রিপোর্ট</h5>
                        <small class="text-muted">New Registrations Report</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Track recent registrations over the last 7, 30, or 90 days with growth summaries and export.
                </p>
                <a asp-action="NewMembers" class="btn btn-outline-success w-100 mt-2">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Report 3: Fee Status / Outstanding -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-warning-subtle text-warning p-3 rounded-3">
                        <i class="fa-solid fa-file-invoice-dollar fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">বকেয়া ফি রিপোর্ট</h5>
                        <small class="text-muted">Fee Status & Outstanding</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Member-by-member payment status, identifying who has paid and who has dues or pending fees.
                </p>
                <a asp-action="FeeStatus" class="btn btn-outline-warning w-100 mt-2">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Report 4: District-wise Breakdown -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-danger-subtle text-danger p-3 rounded-3">
                        <i class="fa-solid fa-map-location-dot fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">জেলা ভিত্তিক রিপোর্ট</h5>
                        <small class="text-muted">District-wise Breakdown</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Geographic distribution of members grouped by district and division, with active vs inactive count.
                </p>
                <a asp-action="DistrictWise" class="btn btn-outline-danger w-100 mt-2">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Report 5: Document Uploads -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-info-subtle text-info p-3 rounded-3">
                        <i class="fa-solid fa-folder-closed fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">ডকুমেন্ট আপলোড রিপোর্ট</h5>
                        <small class="text-muted">Document Archive Report</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Audit of all member verification documents, category counts, file sizes, and missing documents.
                </p>
                <a asp-action="DocumentUploads" class="btn btn-outline-info w-100 mt-2">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Report 6: Monthly Financial Summary -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-secondary-subtle text-dark p-3 rounded-3">
                        <i class="fa-solid fa-chart-column fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">মাসিক আর্থিক রিপোর্ট</h5>
                        <small class="text-muted">Monthly Financial Report</small>
                    </div>
                </div>
                <p class="text-muted small flex-grow-1">
                    Monthly income review, transaction counts, fee type share, and annual collections summary.
                </p>
                <a asp-action="MonthlyFinancial" class="btn btn-outline-dark w-100 mt-2">
                    <i class="fa-solid fa-arrow-right me-1"></i> View Report
                </a>
            </div>
        </div>
    </div>
</div>

