@model MemberManagementSystem.Web.Models.ViewModels.DistrictReportViewModel
@{
    ViewData["Title"] = "District-wise Members Report";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports
        </a>
        <h3 class="fw-bold mt-1 mb-0">জেলা ভিত্তিক সদস্য রিপোর্ট (District-wise Report)</h3>
        <p class="text-muted small mb-0">Geographic breakdown of membership across divisions and districts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DistrictWise" asp-route-export="true" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Report Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">Districts Covered: @Model.Items.Count</span>
        <span class="badge bg-primary">Total Members: @Model.TotalMembers</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">SL</th>
                    <th>Division (বিভাগ)</th>
                    <th>District (জেলা)</th>
                    <th class="text-center">Active Members</th>
                    <th class="text-center">Inactive Members</th>
                    <th class="text-center">Total Members</th>
                    <th class="text-end" style="width: 150px;">Share (%)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    int sl = 1;
                    foreach (var item in Model.Items)
                    {
                        var percentage = Model.TotalMembers > 0 ? (item.MemberCount * 100.0 / Model.TotalMembers) : 0;
                        <tr>
                            <td class="text-center">@(sl++)</td>
                            <td class="fw-semibold">@item.Division</td>
                            <td><span class="badge bg-light text-dark border">@item.District</span></td>
                            <td class="text-center text-success fw-bold">@item.ActiveCount</td>
                            <td class="text-center text-muted">@item.InactiveCount</td>
                            <td class="text-center fw-bold fs-6">@item.MemberCount</td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @percentage%"></div>
                                    </div>
                                    <small class="fw-semibold text-muted">@percentage.ToString("F1")%</small>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No district records available.</td>
                    </tr>
                }
            </tbody>
            @if (Model.Items.Any())
            {
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="3" class="text-end">Total:</td>
                        <td class="text-center text-success">@Model.Items.Sum(i => i.ActiveCount)</td>
                        <td class="text-center text-muted">@Model.Items.Sum(i => i.InactiveCount)</td>
                        <td class="text-center fs-6 text-primary">@Model.TotalMembers</td>
                        <td class="text-end">100.0%</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

