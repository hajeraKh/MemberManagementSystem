@model MemberManagementSystem.Web.Models.ViewModels.FeeStatusReportViewModel
@{
    ViewData["Title"] = "Fee Status & Outstanding Report";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports
        </a>
        <h3 class="fw-bold mt-1 mb-0">বকেয়া ও ফি আদায় রিপোর্ট (Fee Status & Outstanding)</h3>
        <p class="text-muted small mb-0">Overview of paid members and members with pending dues</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="FeeStatus" asp-route-filter="@Model.Filter" asp-route-export="true" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Quick Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 border-start border-4 border-success">
            <small class="text-muted fw-bold text-uppercase">Grand Total Collected</small>
            <div class="fs-3 fw-bold text-success mt-1">৳@Model.GrandTotalCollected.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-start border-4 border-primary">
            <small class="text-muted fw-bold text-uppercase">Total Members Evaluated</small>
            <div class="fs-3 fw-bold mt-1">@Model.Items.Count</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 border-start border-4 border-warning">
            <small class="text-muted fw-bold text-uppercase">Members with Unpaid/Due Status</small>
            <div class="fs-3 fw-bold text-warning mt-1">@Model.Items.Count(i => i.TotalPaid == 0)</div>
        </div>
    </div>
</div>

<!-- Filter Tabs -->
<div class="card mb-4 no-print">
    <div class="card-body p-2">
        <div class="d-flex gap-2">
            <a asp-action="FeeStatus" class="btn btn-sm @(string.IsNullOrEmpty(Model.Filter) ? "btn-primary" : "btn-light border")">All Members</a>
            <a asp-action="FeeStatus" asp-route-filter="Paid" class="btn btn-sm @(Model.Filter == "Paid" ? "btn-success" : "btn-light border")">Paid Members (পরিশোধিত)</a>
            <a asp-action="FeeStatus" asp-route-filter="Unpaid" class="btn btn-sm @(Model.Filter == "Unpaid" ? "btn-warning" : "btn-light border")">Due / Unpaid (বকেয়া)</a>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">SL</th>
                    <th>Member ID</th>
                    <th>Member Name</th>
                    <th>Mobile</th>
                    <th>Member Status</th>
                    <th class="text-end">Total Paid (BDT)</th>
                    <th class="text-center">Payments Count</th>
                    <th>Last Payment Date</th>
                    <th>Fee Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    int sl = 1;
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center">@(sl++)</td>
                            <td><span class="font-monospace fw-bold">@item.Member.MemberCode</span></td>
                            <td class="fw-semibold">
                                <a asp-controller="Members" asp-action="Details" asp-route-id="@item.Member.MemberId" class="text-decoration-none text-dark">
                                    @item.Member.FullName
                                </a>
                            </td>
                            <td>@item.Member.MobileNumber</td>
                            <td>
                                <span class="badge @(item.Member.Status == "Active" ? "bg-success" : "bg-secondary")">@item.Member.Status</span>
                            </td>
                            <td class="text-end fw-bold @(item.TotalPaid > 0 ? "text-success" : "text-muted")">
                                ৳@item.TotalPaid.ToString("N2")
                            </td>
                            <td class="text-center">@item.TotalPaymentsCount</td>
                            <td>@(item.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                @if (item.TotalPaid > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">Pending / Due</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No records match the current filter.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

