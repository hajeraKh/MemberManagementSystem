@model MemberManagementSystem.Web.Models.ViewModels.NewMembersReportViewModel
@{
    ViewData["Title"] = "New Members Report";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports
        </a>
        <h3 class="fw-bold mt-1 mb-0">নতুন সদস্য রিপোর্ট (New Members Report)</h3>
        <p class="text-muted small mb-0">Registrations within past @Model.Days days (from @Model.FromDate.ToString("dd MMM yyyy") to today)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="NewMembers" asp-route-days="@Model.Days" asp-route-export="true" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4 no-print">
    <div class="card-body p-3">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-semibold">Quick Filter Range:</span>
            <a asp-action="NewMembers" asp-route-days="7" class="btn btn-sm @(Model.Days == 7 ? "btn-primary" : "btn-light border")">Last 7 Days</a>
            <a asp-action="NewMembers" asp-route-days="30" class="btn btn-sm @(Model.Days == 30 ? "btn-primary" : "btn-light border")">Last 30 Days</a>
            <a asp-action="NewMembers" asp-route-days="90" class="btn btn-sm @(Model.Days == 90 ? "btn-primary" : "btn-light border")">Last 90 Days</a>
            <a asp-action="NewMembers" asp-route-days="365" class="btn btn-sm @(Model.Days == 365 ? "btn-primary" : "btn-light border")">Last 1 Year</a>
        </div>
    </div>
</div>

<!-- Printable Header -->
<div class="d-none d-print-block text-center mb-4 pb-2 border-bottom">
    <h3 class="fw-bold mb-1">MEMBER MANAGEMENT SYSTEM</h3>
    <h5 class="fw-normal mb-1">নতুন সদস্য তালিকা (New Members Registrations - Last @Model.Days Days)</h5>
    <small class="text-muted">Generated: @DateTime.Now.ToString("dd MMMM yyyy") | Period: @Model.FromDate.ToString("dd/MM/yyyy") - @Model.ToDate.ToString("dd/MM/yyyy")</small>
</div>

<!-- Report Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">New Registrations: @Model.Members.Count</span>
        <span class="badge bg-success-subtle text-success">Active Enrolments</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">SL</th>
                    <th>Member ID</th>
                    <th>Full Name</th>
                    <th>Mobile</th>
                    <th>District</th>
                    <th>Joining Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Members.Any())
                {
                    int sl = 1;
                    foreach (var m in Model.Members)
                    {
                        <tr>
                            <td class="text-center">@(sl++)</td>
                            <td><span class="font-monospace fw-bold">@m.MemberCode</span></td>
                            <td class="fw-semibold">@m.FullName</td>
                            <td>@m.MobileNumber</td>
                            <td>@m.District</td>
                            <td>@m.JoiningDate.ToString("dd MMMM, yyyy")</td>
                            <td>
                                <span class="badge @(m.Status == "Active" ? "bg-success" : "bg-secondary")">@m.Status</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No new members registered in this time period.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

