@model MemberManagementSystem.Web.Models.ViewModels.DocumentReportViewModel
@{
    ViewData["Title"] = "Document Uploads Report";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports
        </a>
        <h3 class="fw-bold mt-1 mb-0">ডকুমেন্ট আপলোড রিপোর্ট (Document Archive Report)</h3>
        <p class="text-muted small mb-0">Audit of uploaded verification files and breakdown by type</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DocumentUploads" asp-route-export="true" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Type Breakdown Cards -->
<div class="row g-3 mb-4">
    @foreach (var type in Model.DocumentsByType)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card p-3 border-start border-4 border-info">
                <small class="text-muted fw-bold text-truncate d-block">@type.Key</small>
                <div class="fs-4 fw-bold mt-1">@type.Value <small class="fs-6 text-muted fw-normal">files</small></div>
            </div>
        </div>
    }
</div>

<!-- Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">Total Uploaded Files: @Model.TotalDocuments</span>
        <span class="badge bg-info-subtle text-info border">Archive Audit</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">SL</th>
                    <th>Document Type</th>
                    <th>File Name</th>
                    <th>Member ID</th>
                    <th>Member Name</th>
                    <th>Upload Date</th>
                    <th>Size (KB)</th>
                    <th class="no-print text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AllDocuments.Any())
                {
                    int sl = 1;
                    foreach (var d in Model.AllDocuments)
                    {
                        <tr>
                            <td class="text-center">@(sl++)</td>
                            <td><span class="badge bg-light text-dark border">@d.DocumentType</span></td>
                            <td class="fw-semibold">
                                <i class="fa-solid fa-file text-secondary me-2"></i>@d.FileName
                            </td>
                            <td><span class="font-monospace">@d.Member?.MemberCode</span></td>
                            <td>
                                @if (d.Member != null)
                                {
                                    <a asp-controller="Members" asp-action="Details" asp-route-id="@d.MemberId" class="text-decoration-none text-dark">
                                        @d.Member.FullName
                                    </a>
                                }
                            </td>
                            <td>@d.UploadDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td>@(d.FileSize.HasValue ? $"{(d.FileSize.Value / 1024.0):F1}" : "-")</td>
                            <td class="no-print text-end">
                                <a asp-controller="Documents" asp-action="Download" asp-route-id="@d.DocumentId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-download"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No documents uploaded.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

