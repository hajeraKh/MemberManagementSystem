@model MemberManagementSystem.Web.Models.ViewModels.MemberListReportViewModel
@{
    ViewData["Title"] = "Member Directory Report";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports
        </a>
        <h3 class="fw-bold mt-1 mb-0">সদস্য তালিকা রিপোর্ট (Member Directory Report)</h3>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MemberList" asp-route-status="@Model.Status" asp-route-district="@Model.District" asp-route-export="true" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4 no-print">
    <div class="card-body p-3">
        <form method="get" asp-action="MemberList" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="status" class="form-select">
                    <option value="">All Status (সকল অবস্থা)</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active (সক্রিয়)</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive (নিষ্ক্রিয়)</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="district" class="form-select">
                    <option value="">All Districts (সকল জেলা)</option>
                    @if (ViewBag.Districts != null)
                    {
                        foreach (string d in ViewBag.Districts)
                        {
                            <option value="@d" selected="@(Model.District == d)">@d</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Printable Report Header -->
<div class="d-none d-print-block text-center mb-4 pb-2 border-bottom">
    <img src="/images/bfra_logo.png" alt="BFRA Logo" style="height: 55px; width: auto; object-fit: contain;" class="mb-2" />
    <h3 class="fw-bold mb-1">BANGLADESH FOOTBALL REFEREE ASSOCIATION</h3>
    <h6 class="text-muted mb-1">বাংলাদেশ ফুটবল রেফারী অ্যাসোসিয়েশন</h6>
    <h5 class="fw-normal mb-1">সদস্য তালিকা রিপোর্ট (Member Directory Report)</h5>
    <small class="text-muted">Generated on: @DateTime.Now.ToString("dd MMMM yyyy, hh:mm tt") | Total Records: @Model.Members.Count</small>
</div>

<!-- Report Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">Total Members: @Model.Members.Count</span>
        <span class="badge bg-light text-dark border">Official Record</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 50px;">SL</th>
                    <th>Member ID</th>
                    <th>Full Name</th>
                    <th>Mobile</th>
                    <th>National ID</th>
                    <th>District</th>
                    <th>Division</th>
                    <th>Joining Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Members.Any())
                {
                    int sl = 1;
                    foreach (var m in Model.Members)
                    {
                        <tr>
                            <td class="text-center">@(sl++)</td>
                            <td><span class="font-monospace fw-bold">@m.MemberCode</span></td>
                            <td class="fw-semibold">@m.FullName</td>
                            <td>@m.MobileNumber</td>
                            <td><small class="font-monospace">@(m.NationalId ?? "-")</small></td>
                            <td>@m.District</td>
                            <td>@m.Division</td>
                            <td>@m.JoiningDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(m.Status == "Active" ? "bg-success" : "bg-secondary")">@m.Status</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">No members found matching filter criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

