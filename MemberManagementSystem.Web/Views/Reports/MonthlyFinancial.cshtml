@model MemberManagementSystem.Web.Models.ViewModels.MonthlyFinancialReportViewModel
@{
    ViewData["Title"] = "Monthly Financial Report";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 no-print">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports
        </a>
        <h3 class="fw-bold mt-1 mb-0">মাসিক আর্থিক রিপোর্ট (Monthly Financial Report)</h3>
        <p class="text-muted small mb-0">Collections summary and revenue breakdown for Year @Model.Year</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MonthlyFinancial" asp-route-year="@Model.Year" asp-route-export="true" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> Export to CSV
        </a>
        <button onclick="window.print()" class="btn btn-primary">
            <i class="fa-solid fa-print me-1"></i> Print Report
        </button>
    </div>
</div>

<!-- Total Card -->
<div class="card bg-primary text-white border-0 shadow-sm mb-4">
    <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <div class="small text-uppercase opacity-75">Year @Model.Year Total Financial Inflow (মোট আদায়)</div>
            <div class="display-6 fw-bold">৳@Model.TotalYearCollection.ToString("N2")</div>
        </div>
        <div>
            <span class="badge bg-white text-primary fs-6 px-3 py-2">
                <i class="fa-solid fa-calendar-check me-1"></i> 12 Months Audited
            </span>
        </div>
    </div>
</div>

<!-- Fee Types Share Row -->
<div class="row g-3 mb-4">
    @foreach (var fee in Model.FeeTypeSummary)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card p-3 border-start border-4 border-success">
                <small class="text-muted fw-bold text-truncate d-block">@fee.Key</small>
                <div class="fs-4 fw-bold mt-1 text-success">৳@fee.Value.ToString("N0")</div>
            </div>
        </div>
    }
</div>

<!-- Monthly Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <span class="fw-bold"><i class="fa-solid fa-table-list text-primary me-2"></i>মাসিক আদায় বিবরণী (Month-by-Month Collections)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">Month #</th>
                    <th>Month Name (মাস)</th>
                    <th class="text-center">Transactions Count (লেনদেন সংখ্যা)</th>
                    <th class="text-end">Total Amount (সর্বমোট টাকা)</th>
                    <th class="text-end" style="width: 150px;">Share (%)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.MonthlySummary)
                {
                    var percent = Model.TotalYearCollection > 0 ? (m.TotalAmount * 100.0m / Model.TotalYearCollection) : 0;
                    <tr>
                        <td class="text-center font-monospace">@m.Month.ToString("D2")</td>
                        <td class="fw-semibold">@m.MonthName @m.Year</td>
                        <td class="text-center">@m.TransactionCount</td>
                        <td class="text-end fw-bold @(m.TotalAmount > 0 ? "text-success" : "text-muted")">
                            ৳@m.TotalAmount.ToString("N2")
                        </td>
                        <td class="text-end">
                            <small class="fw-semibold text-muted">@percent.ToString("F1")%</small>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold">
                    <td colspan="2" class="text-end">Total Annual Collection:</td>
                    <td class="text-center">@Model.MonthlySummary.Sum(m => m.TransactionCount)</td>
                    <td class="text-end text-success fs-5">৳@Model.TotalYearCollection.ToString("N2")</td>
                    <td class="text-end">100.0%</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

