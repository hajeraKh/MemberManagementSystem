@model IEnumerable<MemberManagementSystem.Web.Models.Document>
@{
    ViewData["Title"] = "Documents Repository";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">ডকুমেন্ট ব্যবস্থাপনা (Document Repository)</h3>
        <p class="text-muted small mb-0">Browse, download and manage uploaded member verification files</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Upload" class="btn btn-primary">
            <i class="fa-solid fa-cloud-arrow-up me-1"></i> Upload Document
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="memberId" class="form-select" asp-items="ViewBag.Members">
                    <option value="">All Members (সকল সদস্য)</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="docType" class="form-select">
                    <option value="">All Document Types (সকল ডকুমেন্টের ধরন)</option>
                    <option value="National ID (NID)" selected="@(ViewBag.SelectedDocType == "National ID (NID)")">National ID (NID)</option>
                    <option value="Passport" selected="@(ViewBag.SelectedDocType == "Passport")">Passport</option>
                    <option value="Birth Certificate" selected="@(ViewBag.SelectedDocType == "Birth Certificate")">Birth Certificate</option>
                    <option value="Educational Certificate" selected="@(ViewBag.SelectedDocType == "Educational Certificate")">Educational Certificate</option>
                    <option value="Photo" selected="@(ViewBag.SelectedDocType == "Photo")">Photo</option>
                    <option value="Other" selected="@(ViewBag.SelectedDocType == "Other")">Other</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-light border"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Documents Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>File Name</th>
                    <th>Member Name</th>
                    <th>Member ID</th>
                    <th>Upload Date</th>
                    <th>Size</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border">@doc.DocumentType</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
                                    <span class="fw-semibold small">@doc.FileName</span>
                                </div>
                            </td>
                            <td>
                                @if (doc.Member != null)
                                {
                                    <a asp-controller="Members" asp-action="Details" asp-route-id="@doc.MemberId" class="text-decoration-none fw-semibold text-dark">
                                        @doc.Member.FullName
                                    </a>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">@doc.Member?.MemberCode</span></td>
                            <td>@doc.UploadDate.ToString("dd MMM yyyy")</td>
                            <td>@(doc.FileSize.HasValue ? $"{(doc.FileSize.Value / 1024.0):F1} KB" : "-")</td>
                            <td><small class="text-muted">@(doc.Remarks ?? "-")</small></td>
                            <td class="text-end">
                                <a asp-action="Download" asp-route-id="@doc.DocumentId" class="btn btn-sm btn-outline-primary" title="Download Document">
                                    <i class="fa-solid fa-download"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("DataEntry"))
                                {
                                    <form asp-action="Delete" asp-route-id="@doc.DocumentId" method="post" class="d-inline" onsubmit="return confirm('Delete this document?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No documents found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

