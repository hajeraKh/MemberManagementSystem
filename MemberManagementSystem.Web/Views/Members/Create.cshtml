@model MemberManagementSystem.Web.Models.ViewModels.MemberFormViewModel
@{
    ViewData["Title"] = "Register Member";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Members
    </a>
    <h3 class="fw-bold mt-1">সদস্য নিবন্ধন (Member Registration Form)</h3>
    <p class="text-muted small">Enter personal information, contact details, and upload photograph</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-4">
                <!-- Left Column: Photo Upload & Preview -->
                <div class="col-lg-3 text-center">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-block">Member Photograph (ছবি)</label>
                        <div class="position-relative d-inline-block">
                            <img id="photoPreview" src="https://via.placeholder.com/150x150?text=Upload+Photo" class="rounded-3 border shadow-sm" style="width: 150px; height: 150px; object-fit: cover;" alt="Preview" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <input asp-for="PhotoFile" type="file" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this);" />
                        <span asp-validation-for="PhotoFile" class="text-danger small"></span>
                        <small class="text-muted d-block mt-1">Format: JPG, PNG (Max 5MB)</small>
                    </div>

                    <div class="card bg-light border-0 p-3 text-start small">
                        <div class="fw-bold mb-1"><i class="fa-solid fa-circle-info text-primary me-1"></i> Quick Tips:</div>
                        <ul class="ps-3 mb-0 text-muted">
                            <li>Member ID is automatically generated.</li>
                            <li>Mobile number is used for SMS and identification.</li>
                        </ul>
                    </div>
                </div>

                <!-- Right Column: Personal & Contact Information -->
                <div class="col-lg-9">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="MemberCode" class="form-label fw-semibold small">সদস্য আইডি (Member ID)</label>
                            <input asp-for="MemberCode" class="form-control font-monospace bg-light" readonly />
                            <span asp-validation-for="MemberCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="FullName" class="form-label fw-semibold small">পূর্ণ নাম (Full Name) *</label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. মোহাম্মদ রফিকুল ইসলাম" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FatherName" class="form-label fw-semibold small">পিতার নাম (Father's Name)</label>
                            <input asp-for="FatherName" class="form-control" placeholder="Father's Name" />
                            <span asp-validation-for="FatherName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MotherName" class="form-label fw-semibold small">মাতার নাম (Mother's Name)</label>
                            <input asp-for="MotherName" class="form-control" placeholder="Mother's Name" />
                            <span asp-validation-for="MotherName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold small">জন্ম তারিখ (Date of Birth)</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NationalId" class="form-label fw-semibold small">জাতীয় পরিচয়পত্র (NID / Birth Reg)</label>
                            <input asp-for="NationalId" class="form-control" placeholder="NID Number" />
                            <span asp-validation-for="NationalId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MobileNumber" class="form-label fw-semibold small">মোবাইল নম্বর (Mobile Number) *</label>
                            <input asp-for="MobileNumber" class="form-control" placeholder="e.g. 01711223344" />
                            <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">ইমেইল (Email)</label>
                            <input asp-for="Email" class="form-control" placeholder="member@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Division" class="form-label fw-semibold small">বিভাগ (Division)</label>
                            <select asp-for="Division" class="form-select">
                                <option value="">Select Division</option>
                                <option value="Dhaka">Dhaka (ঢাকা)</option>
                                <option value="Chittagong">Chittagong (চট্টগ্রাম)</option>
                                <option value="Rajshahi">Rajshahi (রাজশাহী)</option>
                                <option value="Khulna">Khulna (খুলনা)</option>
                                <option value="Barisal">Barisal (বরিশাল)</option>
                                <option value="Sylhet">Sylhet (সিলেট)</option>
                                <option value="Rangpur">Rangpur (রংপুর)</option>
                                <option value="Mymensingh">Mymensingh (ময়মনসিংহ)</option>
                            </select>
                            <span asp-validation-for="Division" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="District" class="form-label fw-semibold small">জেলা (District)</label>
                            <input asp-for="District" class="form-control" placeholder="e.g. Dhaka, Cumilla" />
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-semibold small">ঠিকানা (Address)</label>
                            <textarea asp-for="Address" rows="2" class="form-control" placeholder="House, Road, Area, Village..."></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small">অবস্থা (Status) *</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active (সক্রিয়)</option>
                                <option value="Inactive">Inactive (নিষ্ক্রিয়)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="JoiningDate" class="form-label fw-semibold small">যোগদানের তারিখ (Joining Date) *</label>
                            <input asp-for="JoiningDate" type="date" class="form-control" />
                            <span asp-validation-for="JoiningDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Remarks" class="form-label fw-semibold small">মন্তব্য (Remarks)</label>
                            <input asp-for="Remarks" class="form-control" placeholder="Optional notes" />
                            <span asp-validation-for="Remarks" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fa-solid fa-save me-1"></i> Save & Register Member
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('photoPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
}

