@model IEnumerable<MemberManagementSystem.Web.Models.Member>
@{
    ViewData["Title"] = "Members Directory";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">সদস্য তথ্য (Members Directory)</h3>
        <p class="text-muted small mb-0">Manage registered members, profile information and status</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-user-plus me-1"></i> Register New Member
        </a>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by name, mobile, member ID, or NID..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="district" class="form-select">
                    <option value="">All Districts (সকল জেলা)</option>
                    @if (ViewBag.Districts != null)
                    {
                        foreach (string d in ViewBag.Districts)
                        {
                            <option value="@d" selected="@(ViewBag.CurrentDistrict == d)">@d</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(ViewBag.CurrentStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.CurrentStatus == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-light border"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Members Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">Photo</th>
                    <th>Member ID</th>
                    <th>Full Name</th>
                    <th>Mobile</th>
                    <th>District</th>
                    <th>Joining Date</th>
                    <th>Status</th>
                    <th class="text-end" style="min-width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PhotoPath))
                                {
                                    <img src="@item.PhotoPath" class="rounded-circle border" style="width: 42px; height: 42px; object-fit: cover;" alt="@item.FullName" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary border" style="width: 42px; height: 42px;">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">@item.MemberCode</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MemberId" class="fw-semibold text-decoration-none text-dark d-block">
                                    @item.FullName
                                </a>
                                @if (!string.IsNullOrEmpty(item.Email))
                                {
                                    <small class="text-muted"><i class="fa-regular fa-envelope me-1"></i>@item.Email</small>
                                }
                            </td>
                            <td><i class="fa-solid fa-phone text-muted me-1 small"></i>@item.MobileNumber</td>
                            <td>@item.District</td>
                            <td>@item.JoiningDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge @(item.Status == "Active" ? "bg-success" : "bg-secondary")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-info" title="View Profile">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-primary" title="Edit Member">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-action="Card" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-secondary" title="Print ID Card">
                                    <i class="fa-solid fa-id-badge"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-user-slash fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No members found matching your filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

