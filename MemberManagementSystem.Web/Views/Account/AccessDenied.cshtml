@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="fa-solid fa-ban"></i></div>
    <h2 class="fw-bold">Access Denied</h2>
    <p class="text-muted">You do not have permission to view or execute this action under your current role.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="fa-solid fa-arrow-left me-1"></i> Return to Dashboard
    </a>
</div>

